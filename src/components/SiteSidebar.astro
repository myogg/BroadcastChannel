---
interface TagItem {
  href: string
  label: string
  size: number
  color: string
}

const {
  tags = [],
  hasMoreTags = false,
  tagsPathname,
} = Astro.props as {
  tags?: TagItem[]
  hasMoreTags?: boolean
  tagsPathname: string
}
---

<aside class="site-sidebar">
  {
    tags.length > 0 && (
      <div class="sidebar-tags">
        <h2>Tags</h2>
        <div class="tags">
          {tags.map((tag) => (
            <a href={tag.href} style={`font-size: ${tag.size}em; color: ${tag.color}`}>
              {tag.label}
            </a>
          ))}
        </div>
        {
          hasMoreTags && (
            <a class="sidebar-tags-more" href={tagsPathname}>查看全部标签 →</a>
          )
        }
      </div>
    )
  }
</aside>
