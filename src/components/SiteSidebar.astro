---
interface TagItem {
  href: string
  label: string
  size: number
  color: string
}

const { tags = [] } = Astro.props as {
  tags?: TagItem[]
}
---

<aside class="site-sidebar">
  {
    tags.length > 0 && (
      <div class="sidebar-tags">
        <h2>Tags</h2>
        <div class="tags">
          {tags.map((tag) => (
            <a href={tag.href} style={`font-size: ${tag.size}em; color: ${tag.color}`}>
              {tag.label}
            </a>
          ))}
        </div>
      </div>
    )
  }
</aside>
