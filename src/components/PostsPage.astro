---
import BaseLayout from '../layouts/BaseLayout.astro'
import PostEntry from '../components/PostEntry.astro'
import type { ChannelInfo, Post, SeoMeta } from '../types'

const { SITE_URL } = Astro.locals
const {
  channel,
  before: showOlder = true,
  after: showNewer = true,
  isDetail = false,
  pageClass,
  pageHeading,
  pageSeo,
  pageType,
  prevPost = null,
  nextPost = null,
} = Astro.props as {
  channel: ChannelInfo
  before?: boolean
  after?: boolean
  isDetail?: boolean
  pageClass?: string
  pageHeading?: string
  pageSeo?: SeoMeta
  pageType: 'home' | 'post' | 'page'
  prevPost?: Post | null
  nextPost?: Post | null
}
const posts = channel.posts ?? []

const beforeCursor = posts[posts.length - 1]?.id
const afterCursor = posts[0]?.id
// Detail pages link straight to the adjacent post; feed pages keep the cursor
// pagination they have always used.
const olderHref = prevPost
  ? `${SITE_URL}posts/${prevPost.id}`
  : showOlder && beforeCursor && Number(beforeCursor) > 1
    ? `${SITE_URL}before/${beforeCursor}`
    : null
const newerHref = nextPost
  ? `${SITE_URL}posts/${nextPost.id}`
  : showNewer && afterCursor
    ? `${SITE_URL}after/${afterCursor}`
    : null
// Post titles are derived from post text and repeat for some posts, so they make
// poor labels; keep the same generic wording the feed pagination already uses.
const olderLabel = prevPost ? 'Previous post' : 'Older posts'
const newerLabel = nextPost ? 'Next post' : 'Newer posts'
---

<BaseLayout channel={channel} pageClass={pageClass} seo={pageSeo} pageType={pageType}>
  {pageHeading ? <h1 class="sr-only">{pageHeading}</h1> : null}
  <slot name="header" />
  <ol class="posts-feed" aria-label={isDetail ? 'Post' : 'Posts'}>
    {
      posts.map((post) => (
        <li>
          <PostEntry post={post} isDetail={isDetail} channelAvatar={channel.avatar} channelTitle={channel.title} />
        </li>
      ))
    }
  </ol>

  {
    olderHref || newerHref ? (
      <nav class="pagination" aria-label="Pagination">
        {olderHref ? (
          <a href={olderHref} title={olderLabel} aria-label={olderLabel} class="older">
            <span aria-hidden="true">←</span>
          </a>
        ) : null}
        {newerHref ? (
          <a href={newerHref} title={newerLabel} aria-label={newerLabel} class="newer">
            <span aria-hidden="true">→</span>
          </a>
        ) : null}
      </nav>
    ) : null
  }
</BaseLayout>
