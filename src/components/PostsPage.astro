---
import BaseLayout from '../layouts/BaseLayout.astro'
import PostEntry from '../components/PostEntry.astro'
import type { ChannelInfo, Post, SeoMeta } from '../types'

const { SITE_URL } = Astro.locals
const {
  channel,
  before: showOlder = true,
  after: showNewer = true,
  isDetail = false,
  pageClass,
  pageHeading,
  pageSeo,
  pageType,
  prevPost = null,
  nextPost = null,
} = Astro.props as {
  channel: ChannelInfo
  before?: boolean
  after?: boolean
  isDetail?: boolean
  pageClass?: string
  pageHeading?: string
  pageSeo?: SeoMeta
  pageType: 'home' | 'post' | 'page'
  prevPost?: Post | null
  nextPost?: Post | null
}
const posts = channel.posts ?? []

const beforeCursor = posts[posts.length - 1]?.id
const afterCursor = posts[0]?.id
// Detail pages link straight to the adjacent post; feed pages keep the cursor
// pagination they have always used.
const olderHref = prevPost
  ? `${SITE_URL}posts/${prevPost.id}`
  : showOlder && beforeCursor && Number(beforeCursor) > 1
    ? `${SITE_URL}before/${beforeCursor}`
    : null
const newerHref = nextPost
  ? `${SITE_URL}posts/${nextPost.id}`
  : showNewer && afterCursor
    ? `${SITE_URL}after/${afterCursor}`
    : null
const olderLabel = prevPost ? 'Previous post' : 'Older posts'
const newerLabel = nextPost ? 'Next post' : 'Newer posts'
const prevTitle = prevPost?.title.trim() ?? ''
const nextTitle = nextPost?.title.trim() ?? ''
const prevAriaLabel = prevTitle ? `${olderLabel}: ${prevTitle}` : olderLabel
const nextAriaLabel = nextTitle ? `${newerLabel}: ${nextTitle}` : newerLabel
---

<BaseLayout channel={channel} pageClass={pageClass} seo={pageSeo} pageType={pageType}>
  {pageHeading ? <h1 class="sr-only">{pageHeading}</h1> : null}
  <slot name="header" />
  <ol class="posts-feed" aria-label={isDetail ? 'Post' : 'Posts'}>
    {
      posts.map((post) => (
        <li>
          <PostEntry post={post} isDetail={isDetail} channelAvatar={channel.avatar} channelTitle={channel.title} />
        </li>
      ))
    }
  </ol>

  {
    olderHref || newerHref ? (
      <nav class={isDetail ? 'pagination post-nav' : 'pagination'} aria-label="Pagination">
        {prevPost ? (
          <div class="post-nav__item">
            <a href={olderHref} title={prevTitle || olderLabel} aria-label={prevAriaLabel} class="older">
              <span aria-hidden="true">←</span>
            </a>
            {prevTitle ? <span class="post-nav__label">{prevTitle}</span> : null}
          </div>
        ) : null}
        {nextPost ? (
          <div class="post-nav__item post-nav__item--next">
            {nextTitle ? <span class="post-nav__label">{nextTitle}</span> : null}
            <a href={newerHref} title={nextTitle || newerLabel} aria-label={nextAriaLabel} class="newer">
              <span aria-hidden="true">→</span>
            </a>
          </div>
        ) : null}
        {!isDetail && olderHref ? (
          <a href={olderHref} title={olderLabel} aria-label={olderLabel} class="older">
            <span aria-hidden="true">←</span>
          </a>
        ) : null}
        {!isDetail && newerHref ? (
          <a href={newerHref} title={newerLabel} aria-label={newerLabel} class="newer">
            <span aria-hidden="true">→</span>
          </a>
        ) : null}
      </nav>
    ) : null
  }
</BaseLayout>
