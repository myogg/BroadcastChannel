---
import '../styles/app.css'
import { SEO } from 'astro-seo'
import BackToTop from '../components/BackToTop.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteNavigation from '../components/SiteNavigation.astro'
import SiteSidebar from '../components/SiteSidebar.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { getEnv, parseDelimitedItems } from '../lib/env'
import { getPageSeo } from '../lib/seo'
import type { ChannelInfo, SeoMeta } from '../types'

const { SITE_URL, RSS_URL, RSS_PREFIX } = Astro.locals
const { channel, pageClass, pageType, seo } = Astro.props as {
  channel: ChannelInfo
  pageClass?: string
  pageType: 'home' | 'post' | 'page'
  seo?: SeoMeta
}

const locale = getEnv(import.meta.env, 'LOCALE')
const twitter = getEnv(import.meta.env, 'TWITTER')
const {
  currentPathname,
  hasCustomTitle,
  archivePathname,
  linksPathname,
  seoParams,
  siteRootPathname,
  siteTitle,
  tagsPathname,
} = getPageSeo({
  channel,
  locale,
  seo,
  siteUrl: SITE_URL,
  url: Astro.url,
})

const GOOGLE_SEARCH_SITE = getEnv(import.meta.env, 'GOOGLE_SEARCH_SITE')
const searchAction = GOOGLE_SEARCH_SITE ? 'https://www.google.com/search' : `${SITE_URL}search/result`

const HEADER_INJECT = getEnv(import.meta.env, 'HEADER_INJECT')
const FOOTER_INJECT = getEnv(import.meta.env, 'FOOTER_INJECT')
const TAGS = getEnv(import.meta.env, 'TAGS')
const sidebarTags = (() => {
  const counts = new Map<string, number>()
  for (const post of channel.posts) {
    for (const tag of post.tags) {
      counts.set(tag, (counts.get(tag) ?? 0) + 1)
    }
  }
  const sorted = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 50)
  if (sorted.length === 0) return []
  const min = sorted[sorted.length - 1][1]
  const max = sorted[0][1]
  const range = max - min || 1
  const tagColors = ['#e8832a', '#5b8c3e', '#3a8fb7', '#7b61a5', '#b07d4f', '#c4516d', '#2e8b7a', '#8b6e3e']
  return sorted.map(([tag, count], i) => {
    const ratio = (count - min) / range
    let color: string
    if (i === 0) {
      color = '#e44d6e'
    } else if (ratio < 0.15) {
      color = '#333'
    } else {
      color = tagColors[i % tagColors.length]
    }
    return {
      href: `/search/result?q=${encodeURIComponent(`#${tag}`)}`,
      label: tag,
      size: 0.65 + ratio * 0.85,
      color,
    }
  })
})()
const LINKS = getEnv(import.meta.env, 'LINKS')
const navs = parseDelimitedItems(getEnv(import.meta.env, 'NAVS'))

const skipLinkText = 'Skip to main content'
---

<!doctype html>
<html lang={locale ?? 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="alternate" type="application/rss+xml" title={`${RSS_PREFIX}${channel?.title}`} href={RSS_URL} />
    <SEO
      titleTemplate={hasCustomTitle ? `%s | ${siteTitle}` : undefined}
      titleDefault={siteTitle || seoParams.description}
      twitter={{
        card: 'summary_large_image',
        creator: twitter ? `@${twitter}` : undefined,
      }}
      {...seoParams}
    />
    <Fragment set:html={HEADER_INJECT} />
  </head>

  <body class:list={[pageType, pageClass]}>
    <a href="#main-content" class="skip-link">{skipLinkText}</a>
    <SiteHeader channel={channel}>
      <SiteNavigation
        channelTitle={channel?.title}
        currentPathname={currentPathname}
        archivePathname={archivePathname}
        linksPathname={linksPathname}
        navs={navs}
        showLinks={Boolean(LINKS)}
        showTags={Boolean(TAGS)}
        siteRootPathname={siteRootPathname}
        siteUrl={SITE_URL}
        tagsPathname={tagsPathname}
      />
    </SiteHeader>
    <div class="layout-body">
      <main id="main-content">
        <slot />
      </main>
      <SiteSidebar searchAction={searchAction} googleSearchSite={GOOGLE_SEARCH_SITE} tags={sidebarTags} />
    </div>
    <SiteFooter />
    <BackToTop />
    <Fragment set:html={FOOTER_INJECT} />
  </body>
</html>
