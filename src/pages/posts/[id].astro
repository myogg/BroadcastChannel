---
import PostsPage from '../../components/PostsPage.astro'
import { getChannelInfo, getChannelPost } from '../../lib/telegram'

const channelInfo = await getChannelInfo()

if (!Astro.params.id) {
  return Astro.redirect('/')
}

const post = channelInfo.posts.find((item) => item.id === Astro.params.id) ?? (await getChannelPost(Astro.params.id))

if (!post) {
  return new Response('Not Found', {
    status: 404,
    headers: {
      'Cache-Control': 'public, max-age=300, s-maxage=300',
    },
  })
}

const channel = {
  ...(channelInfo || {}),
  posts: [post],
}

// Neighbouring posts come from the two adjacent Telegram pages, one on each
// side of this id. Both requests are cached. Pick by id rather than by position:
// `posts` is newest-first, and a page can span a gap of deleted messages.
const [olderPage, newerPage] = await Promise.all([
  getChannelInfo({ before: post.id }),
  getChannelInfo({ after: post.id }),
])
const id = Number(post.id)
const prevPost =
  olderPage.posts.filter((item) => Number(item.id) < id).sort((a, b) => Number(b.id) - Number(a.id))[0] ?? null
const nextPost =
  newerPage.posts.filter((item) => Number(item.id) > id).sort((a, b) => Number(a.id) - Number(b.id))[0] ?? null
---

<PostsPage
  channel={channel}
  before={false}
  after={false}
  isDetail={true}
  pageHeading={post.title || channel.title}
  pageSeo={post}
  pageType="post"
  prevPost={prevPost}
  nextPost={nextPost}
/>
